#!/bin/sh

set -eu

if [ "${1:-}" = "--check-file" ]; then
  if [ "$#" -ne 2 ]; then
    echo "Usage: $0 --check-file <cpuinfo-path>" >&2
    exit 2
  fi
  cpuinfo_path="$2"
else
  case "${1:-}" in
    install|upgrade)
      cpuinfo_path="/proc/cpuinfo"
      ;;
    *)
      exit 0
      ;;
  esac
fi

if [ ! -r "$cpuinfo_path" ]; then
  echo "paperq requires an x86-64-v3 CPU, but CPU features could not be read from $cpuinfo_path." >&2
  exit 1
fi

flags="$(
  awk -F: '
    /^[[:space:]]*flags[[:space:]]*:/ {
      print $2
      exit
    }
  ' "$cpuinfo_path"
)"

if [ -z "$flags" ]; then
  echo "paperq requires an x86-64-v3 CPU, but no CPU feature list was found in $cpuinfo_path." >&2
  exit 1
fi

has_flag() {
  case " $flags " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

require_flag() {
  if ! has_flag "$1"; then
    echo "paperq requires an x86-64-v3 CPU; missing CPU feature: $1." >&2
    exit 1
  fi
}

require_one_of() {
  if ! has_flag "$1" && ! has_flag "$2"; then
    echo "paperq requires an x86-64-v3 CPU; missing CPU feature: $3." >&2
    exit 1
  fi
}

for feature in cx16 lahf_lm popcnt ssse3 sse4_1 sse4_2 avx avx2 bmi1 bmi2 f16c fma movbe xsave; do
  require_flag "$feature"
done
require_one_of pni sse3 "sse3 (pni)"
require_one_of abm lzcnt "lzcnt (abm)"

exit 0
